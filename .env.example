# Path to the SQLite database file (doc mappings, known tabs, code->hours table).
# Docker image sets this to /data/roster.db (mounted volume) — see Dockerfile.
DB_PATH=roster.db

# Google Sheets API v4 key, used ONLY to list a doc's tabs (CSV export can't
# enumerate tabs). Get one: console.cloud.google.com -> enable "Google Sheets
# API" -> Credentials -> Create API key -> restrict it to Sheets API.
GOOGLE_API_KEY=

# Random secret for signing the session cookie (login state). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Any value works for local dev; MUST be a real random secret in production.
SECRET_KEY=dev-secret-change-me

# Path to the JSON file mapping username -> bcrypt password hash (see
# accounts.json.example). Docker image sets this to /data/accounts.json.
# Ignored if ACCOUNTS_JSON (below) is set.
ACCOUNTS_FILE=accounts.json

# --- Serverless deploy (e.g. Vercel) ---
# Vercel's filesystem is read-only except /tmp, so DB_PATH/ACCOUNTS_FILE
# (local files) don't work there. Use these instead:

# Same username -> bcrypt hash mapping as accounts.json, inlined as JSON text
# (no file needed). Takes priority over ACCOUNTS_FILE when set.
ACCOUNTS_JSON=

# Turso (hosted libSQL) database URL + auth token. When set, the app talks to
# this remote database over HTTP instead of a local SQLite file — required on
# Vercel since a local .db file wouldn't persist between invocations.
# Create a free database: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
